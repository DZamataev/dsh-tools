{
  "name": "@local/dsh-provider-limits",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Remaining quota of configured LLM provider routes (TeamClaude, codex-lb, OpenCode Go) in the composer dock.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "normalize.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "scripts": { "test": "node --test tests/" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-chat"]
    }
  }
}
