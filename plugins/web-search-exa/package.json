{
  "name": "@local/dsh-web-search-exa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Routes the built-in web_search tool through Exa (EXA_API_KEY) instead of DeepSeek search.",
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dependencies": {
    "@deepseek-ai/dsh-web-search-exa": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
