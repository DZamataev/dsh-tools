{
  "name": "@local/dsh-drafts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lists unfinished prompt drafts of other New Sessions on the New Session page and reopens them.",
  "engines": { "dsh": ">=0.2.1-rc.2 <0.3.0" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "scripts": { "test": "node --test tests/" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-workspace"]
    }
  }
}
