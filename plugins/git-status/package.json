{
  "name": "@local/dsh-git-status",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The session's git branch in the composer status bar; its panel shows the working directory, its size, a copy-path button, and a short git status.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "git.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "scripts": { "test": "node --test tests/" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
